<div class="hero">
  <div class="hero-content">
    <h1 class="hero-title">Une infirmière près de chez vous, en quelques clics</h1>
    <p class="hero-subtitle">Des soins à domicile, partout en France</p>

    <%= form_with url: root_path, method: :get, local: true, class: "search-bar" do |f| %>
      <span class="search-icon"><i class="fas fa-map-marker-alt"></i></span>
      <%= f.text_field :commune, value: params[:commune], placeholder: "Entrez votre commune...", class: "search-input" %>
      <%= f.submit "Rechercher", class: "btn btn-nursy-primary search-btn" %>
    <% end %>

    <div class="stats">
      <div class="stat"><span class="stat-number">1200+</span><span class="stat-label">Infirmières</span></div>
      <div class="stat"><span class="stat-number">850+</span><span class="stat-label">Communes couvertes</span></div>
      <div class="stat"><span class="stat-number">4.8/5</span><span class="stat-label">Note moyenne</span></div>
    </div>

    <div class="badges">
      <span class="badge">Infirmières vérifiées RPPS</span>
      <span class="badge">Disponibilité en temps réel</span>
    </div>
  </div>
</div>

<% if params[:commune].present? %>
  <section class="home-results container my-5" data-controller="scroll-into-view">
    <% if @nurses.any? %>
      <div class="d-flex justify-content-between align-items-center">
        <h2 class="results-title">
          Infirmières disponibles <%= @commune ? "près de #{@commune.name}" : "pour votre recherche" %>
        </h2>
        <%= link_to "Voir tous les résultats →", nurses_path(commune: params[:commune]), class: "see-all-link" %>
      </div>
      <div class="results-grid">
        <%
          specialty_card_colors = {
            "Pansements complexes" => "teal",
            "Vaccination"          => "green",
            "Soins Palliatifs"     => "pink",
            "Pédiatrie"            => "purple",
            "Gériatrie"            => "orange",
            "Injections"           => "indigo",
            "Perfusions"           => "cyan",
            "Suivi diabétique"     => "amber",
            "Soins post-op."       => "blue",
            "Personnes âgées"      => "red"
          }
          priority_order = specialty_card_colors.keys
        %>
        <% @nurses.each do |nurse| %>
          <% nurse_specialty_names = nurse.specialties.map(&:name) %>
          <% main_specialty = priority_order.find { |s| nurse_specialty_names.include?(s) } %>
          <% color = specialty_card_colors[main_specialty] || "teal" %>
          <%= render "nurses/nurse_card", nurse: nurse, color: color %>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted">Aucune infirmière trouvée près de « <%= params[:commune] %> ».</p>
    <% end %>
  </section>
<% end %>
