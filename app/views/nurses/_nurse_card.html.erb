<% color = nurse.card_color %>
<div class="nurse-card mb-3 card-<%= color %>">
  <div class="nurse-avatar <%= "avatar-#{color}" unless nurse.photo.attached? %>">
    <% if nurse.photo.attached? %>
      <%= image_tag nurse.photo, alt: "Photo de #{nurse.first_name} #{nurse.last_name}", style: "width: 100%; height: 100%; object-fit: cover; border-radius: 14px;" %>
    <% else %>
      <%= nurse.first_name[0] %><%= nurse.last_name[0] %>
    <% end %>
    <span class="avatar-badge badge-<%= color %>-icon">
      <i class="fas fa-user-check"></i>
    </span>
  </div>
  <div>
    <h5><%= nurse.first_name %> <%= nurse.last_name %></h5>
    <p class="nurse-address"><i class="fas fa-map-marker-alt"></i> <%= nurse.commune.name %></p>
    <p class="nurse-rating"><i class="fas fa-star"></i> <%= nurse.average_rating %></p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <% nurse.specialties.each do |specialty| %>
      <span class="badge-<%= nurse.specialty_color(specialty.name) %>"><%= specialty.name %></span>
    <% end %>
  </div>
  <%= link_to "Voir le profil", nurse_path(nurse), class: "btn btn-nursy-primary btn-sm" %>
</div>
