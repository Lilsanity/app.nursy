<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "App Nursy" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App Nursy">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand navbar-lewagon">
      <div class="container-fluid">
        <%= link_to "Nursy", root_path, class: "navbar-brand" %>

        <ul class="navbar-nav mx-auto" data-controller="navbar" data-action="mouseleave->navbar#reset">
          <li class="nav-indicator" data-navbar-target="indicator" aria-hidden="true"></li>
          <li class="nav-item">
            <%= link_to "Accueil", root_path, class: class_names("nav-link", active: current_page?(root_path)), data: { navbar_target: "link", action: "mouseenter->navbar#highlight" } %>
          </li>
          <li class="nav-item">
            <%= link_to "Recherche", nurses_path, class: class_names("nav-link", active: current_page?(nurses_path)), data: { navbar_target: "link", action: "mouseenter->navbar#highlight" } %>
          </li>
          <li class="nav-item">
            <%= link_to "Mon espace", my_space_path, class: class_names("nav-link", active: current_page?(my_space_path)), data: { navbar_target: "link", action: "mouseenter->navbar#highlight" } %>
          </li>
        </ul>

        <ul class="navbar-nav ms-auto">
          <% if user_signed_in? %>
            <% if current_user.photo.attached? %>
              <li class="nav-item d-flex align-items-center me-3">
                <%= image_tag current_user.photo, alt: "#{current_user.first_name} #{current_user.last_name}", class: "rounded-circle", style: "width: 36px; height: 36px; object-fit: cover;" %>
              </li>
            <% end %>
            <li class="nav-item">
              <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-nursy-pill btn-sm btn-logout" do %>
                <i class="fas fa-arrow-right-from-bracket me-1"></i>Se déconnecter
              <% end %>
            </li>
          <% else %>
            <li class="nav-item me-2">
              <%= link_to "Se connecter", new_user_session_path, class: "btn btn-nursy-primary btn-sm" %>
            </li>
            <li class="nav-item">
              <%= link_to "Créer un compte", new_user_registration_path, class: "btn btn-nursy-pill btn-sm" %>
            </li>
          <% end %>
        </ul>
      </div>
    </nav>

    <% flash.each do |type, message| %>
      <div class="alert alert-<%= type == "notice" ? "success" : "danger" %>" role="alert">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
    <footer class="site-footer">
      <p>© 2026 Nursy — Tous droits réservés</p>
    </footer>
  </body>
</html>
